---
BasedOnStyle: Google

# Line breaking
ColumnLimit: 80
AllowShortFunctionsOnASingleLine: None

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Pointers
PointerAlignment: Right

# Includes
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<glad/glad\.h>$'
    Priority: 0
    SortPriority: 0
  - Regex: '^<GLFW/glfw3\.h>$'
    Priority: 0
    SortPriority: 1
  - Regex: '^<.*>$'
    Priority: 0
    SortPriority: 2
  - Regex: '^".*"$'
    Priority: 1
...
